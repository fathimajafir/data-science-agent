# TabPFN settings ----------------------------------------------------------
# Backend: auto | api | local | fallback
#   api      -> hosted TabPFN-3.5-Plus, needs TABPFN_TOKEN below (recommended)
#   local    -> tabpfn package with local weights (needs GPU + HF access)
#   fallback -> sklearn placeholder so everything still runs offline
TABPFN_BACKEND=auto

# Free API key: https://platform.priorlabs.ai/account/api-keys
TABPFN_TOKEN=

# Local backend options
TABPFN_MODEL=v3.5-fast
TABPFN_N_ESTIMATORS=8
TABPFN_DEVICE=auto
RANDOM_STATE=42

# LLM for the data science agent (optional) -------------------------------
# Any OpenAI-compatible endpoint works. Without it the agent falls back to a
# deterministic planner and still runs.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
